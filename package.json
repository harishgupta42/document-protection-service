{
  "name": "document-protection-service",
  "version": "1.0.0",
  "description": "HTTP service that password-protects PDF, DOCX, XLSX and PPTX files. Upload a document, get back an encrypted copy and the password.",
  "main": "dist/server.js",
  "license": "MIT",
  "author": "harishgupta42",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "file-type-mime": "^0.4.3",
    "http-errors": "^2.0.0",
    "multer": "^1.4.5-lts.1",
    "officecrypto-tool": "^0.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ]
  }
}
